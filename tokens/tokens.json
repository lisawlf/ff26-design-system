{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Future Forward 2026 (#FF26) design tokens. Extracted from 'ff is back — Launch Day Announcement 2026'. This file is the source of truth; tokens.css and tailwind.preset.js are generated from it.",
  "meta": {
    "name": "Future Forward 2026 Design System",
    "version": "1.0.0",
    "event": {
      "name": "Future Forward 2026",
      "hashtag": "#FF26",
      "date": "26.11.2026",
      "venue": "weXelerate, Praterstraße 1, 1020 Vienna",
      "url": "www.futureforward.at",
      "host": "weXelerate",
      "contact": "ecosystem@wexelerate.com"
    }
  },
  "color": {
    "$type": "color",
    "acid": {
      "$value": "#DCFF00",
      "$description": "THE brand accent. Acid lime. Use for exactly one emphasis per composition: a text highlight, a CTA fill, a table header, or one chart bar. Never as a page background, never for body text."
    },
    "acid-dim": {
      "$value": "#C4E300",
      "$description": "Pressed/hover state of acid on interactive surfaces only."
    },
    "ink": {
      "$value": "#0E0E0E",
      "$description": "Primary text and primary black surfaces. Slightly warmer than pure black."
    },
    "ink-pure": {
      "$value": "#000000",
      "$description": "Display headlines and black bars. Maximum weight."
    },
    "ink-2": {
      "$value": "#333333",
      "$description": "Secondary body copy, lede paragraphs on light."
    },
    "ink-3": {
      "$value": "#555555",
      "$description": "Captions, small supporting copy under stats."
    },
    "ink-4": {
      "$value": "#888888",
      "$description": "Muted. Eyebrows, list descriptions, 'before' column, inactive chart values."
    },
    "paper": {
      "$value": "#FAFAFA",
      "$description": "Default canvas background. Off-white, never pure white."
    },
    "surface": {
      "$value": "#F7F7F7",
      "$description": "Raised panel / list row / callout fill on paper."
    },
    "surface-2": {
      "$value": "#F0F0F0",
      "$description": "Chart track, second-level fill."
    },
    "hairline": {
      "$value": "#E8E8E8",
      "$description": "Default 1px border for cards, tables, panels."
    },
    "hairline-strong": {
      "$value": "#D8D8D8",
      "$description": "Emphasised divider."
    },
    "white": {
      "$value": "#FFFFFF"
    },
    "overlay-scrim": {
      "$value": "rgba(0,0,0,0.38)",
      "$description": "Minimum scrim over photography before white text is placed."
    },
    "overlay-scrim-strong": {
      "$value": "rgba(0,0,0,0.58)",
      "$description": "Scrim for long body copy over busy photography (see venue slide)."
    },
    "linkedin": {
      "$value": "#0A66C2",
      "$description": "Link blue — captions/copy only, never in graphics."
    },
    "navy-ink": {
      "$value": "#08111F",
      "$description": "Deepest ink navy. Base of dark posts built on the earth/astronaut photography. Background only."
    },
    "navy": {
      "$value": "#0F1D33",
      "$description": "Mid navy. Panels and outlined boxes on a navy canvas. Background only, never text."
    },
    "navy-glow": {
      "$value": "#263961",
      "$description": "The horizon glow at the bottom of the earth gradient. Background only."
    }
  },
  "font": {
    "family": {
      "display": {
        "$value": "'Sora', 'Helvetica Neue', Arial, sans-serif",
        "$description": "Sora. Headlines, statement type, buttons, stat labels. Always uppercase at display sizes."
      },
      "body": {
        "$value": "'Barlow', 'Helvetica Neue', Arial, sans-serif",
        "$description": "Barlow. All running copy, list descriptions, captions."
      },
      "mono": {
        "$value": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace",
        "$description": "JetBrains Mono. Eyebrows, date/venue meta, numbers, data labels, stickers. The 'systems' voice of the brand."
      },
      "serif": {
        "$value": "'Noto Serif Display', 'Times New Roman', serif",
        "$description": "Noto Serif Display (Condensed / ExtraCondensed, Light). The editorial lede that sits directly under a display headline. One line, two maximum. Sentence case."
      }
    },
    "weight": {
      "light": {
        "$value": "300"
      },
      "regular": {
        "$value": "400"
      },
      "medium": {
        "$value": "500"
      },
      "semibold": {
        "$value": "600"
      },
      "bold": {
        "$value": "700"
      }
    }
  },
  "typeScale": {
    "$description": "Sizes are px on the 1080×1350 reference canvas. Scale linearly with canvas width via the --ff-scale variable.",
    "display-xl": {
      "size": "92px",
      "lineHeight": "0.94",
      "tracking": "-0.03em",
      "family": "display",
      "weight": "600",
      "case": "uppercase"
    },
    "display-lg": {
      "size": "66px",
      "lineHeight": "0.96",
      "tracking": "-0.025em",
      "family": "display",
      "weight": "600",
      "case": "uppercase"
    },
    "display-md": {
      "size": "64px",
      "lineHeight": "0.98",
      "tracking": "-0.025em",
      "family": "display",
      "weight": "600",
      "case": "uppercase"
    },
    "display-sm": {
      "size": "56px",
      "lineHeight": "1.0",
      "tracking": "-0.02em",
      "family": "display",
      "weight": "600",
      "case": "uppercase"
    },
    "headline": {
      "size": "42px",
      "lineHeight": "1.04",
      "tracking": "-0.02em",
      "family": "display",
      "weight": "700",
      "case": "uppercase"
    },
    "title": {
      "size": "29px",
      "lineHeight": "1.1",
      "tracking": "-0.01em",
      "family": "display",
      "weight": "700",
      "case": "uppercase"
    },
    "label": {
      "size": "21px",
      "lineHeight": "1.2",
      "tracking": "0.01em",
      "family": "display",
      "weight": "700",
      "case": "uppercase"
    },
    "serif-lede": {
      "size": "42px",
      "lineHeight": "1.14",
      "tracking": "0",
      "family": "serif",
      "weight": "300",
      "case": "sentence",
      "width": "62.5 (wdth axis — ExtraCondensed)"
    },
    "serif-sm": {
      "size": "40px",
      "lineHeight": "1.18",
      "tracking": "0",
      "family": "serif",
      "weight": "300",
      "case": "sentence",
      "width": "62.5 (wdth axis — ExtraCondensed)"
    },
    "body-lg": {
      "size": "28px",
      "lineHeight": "1.26",
      "tracking": "0",
      "family": "body",
      "weight": "300"
    },
    "body-md": {
      "size": "27px",
      "lineHeight": "1.3",
      "tracking": "0",
      "family": "body",
      "weight": "400"
    },
    "body": {
      "size": "23px",
      "lineHeight": "1.3",
      "tracking": "0",
      "family": "body",
      "weight": "400"
    },
    "body-sm": {
      "size": "18px",
      "lineHeight": "1.3",
      "tracking": "0",
      "family": "body",
      "weight": "400"
    },
    "caption": {
      "size": "16px",
      "lineHeight": "1.28",
      "tracking": "0",
      "family": "body",
      "weight": "400"
    },
    "caption-xs": {
      "size": "14px",
      "lineHeight": "1.25",
      "tracking": "0",
      "family": "body",
      "weight": "400"
    },
    "eyebrow": {
      "size": "22px",
      "lineHeight": "1.2",
      "tracking": "0.34em",
      "family": "mono",
      "weight": "400",
      "case": "uppercase"
    },
    "meta": {
      "size": "21px",
      "lineHeight": "1.2",
      "tracking": "0.02em",
      "family": "mono",
      "weight": "400",
      "case": "uppercase"
    },
    "mono-data": {
      "size": "41px",
      "lineHeight": "1.0",
      "tracking": "-0.01em",
      "family": "mono",
      "weight": "400"
    },
    "mono-lg": {
      "size": "31px",
      "lineHeight": "1.2",
      "tracking": "0",
      "family": "mono",
      "weight": "400"
    },
    "mono-md": {
      "size": "27px",
      "lineHeight": "1.25",
      "tracking": "0",
      "family": "mono",
      "weight": "400"
    },
    "mono-sm": {
      "size": "21px",
      "lineHeight": "1.25",
      "tracking": "0",
      "family": "mono",
      "weight": "400"
    },
    "mono-xs": {
      "size": "16px",
      "lineHeight": "1.25",
      "tracking": "0",
      "family": "mono",
      "weight": "400"
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "px on the 1080×1350 reference canvas.",
    "0": {
      "$value": "0"
    },
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "5": {
      "$value": "24px"
    },
    "6": {
      "$value": "32px"
    },
    "7": {
      "$value": "40px"
    },
    "8": {
      "$value": "48px"
    },
    "9": {
      "$value": "64px"
    },
    "10": {
      "$value": "80px"
    },
    "11": {
      "$value": "96px"
    },
    "12": {
      "$value": "128px"
    },
    "page": {
      "$value": "108px",
      "$description": "Standard left/right page margin on the 1080 canvas (10%)."
    },
    "page-tight": {
      "$value": "60px",
      "$description": "Margin for full-bleed photo slides where type sits in a bar."
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0"
    },
    "sm": {
      "$value": "6px"
    },
    "md": {
      "$value": "10px",
      "$description": "Cards, list rows, panels. The system default."
    },
    "lg": {
      "$value": "18px"
    },
    "pill": {
      "$value": "999px",
      "$description": "Buttons and arrow indicators."
    }
  },
  "border": {
    "hairline": {
      "$value": "1px solid #E8E8E8"
    },
    "ink": {
      "$value": "2px solid #0E0E0E"
    }
  },
  "canvas": {
    "$description": "Export formats. Every template declares one.",
    "post-4x5": {
      "w": 1080,
      "h": 1350,
      "use": "LinkedIn / Instagram feed carousel. The primary format."
    },
    "post-1x1": {
      "w": 1080,
      "h": 1080,
      "use": "Instagram grid, LinkedIn single image."
    },
    "story-9x16": {
      "w": 1080,
      "h": 1920,
      "use": "Instagram / LinkedIn story, reel cover."
    },
    "banner-16x9": {
      "w": 1920,
      "h": 1080,
      "use": "Presentation slide, YouTube, event screen."
    },
    "linkedin-cover": {
      "w": 1584,
      "h": 396,
      "use": "LinkedIn page / event cover."
    }
  },
  "motion": {
    "$description": "For web and video use only. Static graphics ignore this.",
    "duration-fast": {
      "$value": "160ms"
    },
    "duration-base": {
      "$value": "280ms"
    },
    "duration-slow": {
      "$value": "520ms"
    },
    "ease-out": {
      "$value": "cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "ease-in-out": {
      "$value": "cubic-bezier(0.65, 0, 0.35, 1)"
    }
  },
  "gradient": {
    "earth": {
      "$value": "linear-gradient(180deg, #000000 0%, #000000 30%, #08111F 62%, #263961 100%)",
      "$description": "The only gradient in the system: black space fading into navy atmosphere, used behind or instead of the earth photo. Not for buttons, cards or type."
    }
  }
}
